# GCP project configuration
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1

# BigQuery
BQ_DATASET=insurbot
BQ_LOCATION=US

# Vertex AI
VERTEX_MODEL_ID=gemini-1.5-pro
VERTEX_TEMPERATURE=0.2
VERTEX_MAX_OUTPUT_TOKENS=1024

# Guardrails
GUARDRAIL_MIN_CONFIDENCE=0.75
GUARDRAIL_MAX_RESPONSE_CHARS=2000

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# Dialogflow CX
DIALOGFLOW_AGENT_ID=your-dialogflow-agent-id
DIALOGFLOW_LOCATION=global

# Service account (local dev only; use Workload Identity on Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
